# Application Configuration
APP_NAME="Train Ticket Booking System"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security & JWT
SECRET_KEY=super_secret_jwt_key_train_booking_production_ready_key_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MySQL 8 via Docker Compose)
# Set USE_SQLITE=False when running with docker-compose up
USE_SQLITE=True
DB_HOST=localhost
DB_PORT=3306
DB_USER=train_user
DB_PASSWORD=train_secure_password_2026
DB_NAME=train_booking_db
DATABASE_URL=mysql+pymysql://train_user:train_secure_password_2026@localhost:3306/train_booking_db
SQLITE_FALLBACK_URL=sqlite:///./train_booking.db

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
